@model IEnumerable<ApplicationUser>
@{ViewData["Title"] = "Gebruikersbeheer";}
<h1><i class="bi bi-people"></i> Gebruikersbeheer</h1>
<table class="table table-hover">
    <thead class="table-dark"><tr><th>Naam</th><th>Email</th><th>Rol</th><th>Status</th><th>Acties</th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        var roles = (IDictionary<string, IList<string>>)ViewBag.UserRoles;
        var userRoles = roles.ContainsKey(u.Id) ? string.Join(", ", roles[u.Id]) : "–";
        <tr>
            <td>@u.FirstName @u.LastName</td>
            <td>@u.Email</td>
            <td>@userRoles</td>
            <td><span class="badge bg-@(u.IsActive ? "success" : "danger")">@(u.IsActive ? "Actief" : "Inactief")</span></td>
            <td>
                <form asp-action="AssignRole" method="post" class="d-inline">
                    <input type="hidden" name="userId" value="@u.Id" />
                    <select name="role" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                        @foreach (var r in (IEnumerable<string>)ViewBag.AllRoles)
                        { <option value="@r">@r</option> }
                    </select>
                </form>
                <form asp-action="ToggleActive" method="post" class="d-inline">
                    <input type="hidden" name="userId" value="@u.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Toggle</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
