@model ApplicationUser
@{ViewData["Title"] = "Profiel";}
<h1>Profiel</h1>
<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:60px;height:60px;font-size:1.5rem">
                @Model.FirstName[0]@Model.LastName[0]
            </div>
            <div><h3>@Model.FirstName @Model.LastName</h3><p class="text-muted">@Model.Email</p></div>
        </div>
        <p><strong>Rollen:</strong> @string.Join(", ", (IEnumerable<string>)ViewBag.Roles)</p>
        <p><strong>Aangemaakt:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy")</p>
        <p><strong>Status:</strong> @(Model.IsActive ? "✅ Actief" : "❌ Inactief")</p>
    </div>
</div>
