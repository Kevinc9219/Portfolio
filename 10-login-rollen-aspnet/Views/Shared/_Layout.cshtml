<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - LoginApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="bi bi-shield-lock"></i> LoginApp</a>
        <div class="navbar-nav ms-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                { <a class="nav-link" asp-controller="Reports" asp-action="Index">Rapporten</a> }
                @if (User.IsInRole("Admin"))
                { <a class="nav-link" asp-controller="Admin" asp-action="Index">Beheer</a> }
                <a class="nav-link" asp-controller="Account" asp-action="Profile">@User.Identity.Name</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link nav-link text-white">Uitloggen</button>
                </form>
            }
            else
            {
                <a class="nav-link" asp-controller="Account" asp-action="Login">Inloggen</a>
                <a class="nav-link" asp-controller="Account" asp-action="Register">Registreren</a>
            }
        </div>
    </div>
</nav>
<main class="container mt-4">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
