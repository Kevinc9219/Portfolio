<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CV Analyzer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="bi bi-file-person"></i> AI CV Analyzer</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" asp-controller="Cv" asp-action="Index">Analyseer CV</a>
            <a class="nav-link" asp-controller="Cv" asp-action="History">Geschiedenis</a>
        </div>
    </div>
</nav>
<main class="container mt-4">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
