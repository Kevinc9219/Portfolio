@{ViewData["Title"] = "CV Analyseren";}
<div class="row justify-content-center">
<div class="col-md-8">
    <div class="card shadow">
        <div class="card-header bg-dark text-white"><h4><i class="bi bi-cpu"></i> AI CV Analyzer</h4><p class="mb-0 text-muted">Ontvang directe AI-feedback op je cv</p></div>
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            { <div class="alert alert-danger"><ul>@foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors)) { <li>@e.ErrorMessage</li> }</ul></div> }
            <form asp-action="Analyze" method="post" enctype="multipart/form-data">
                <ul class="nav nav-tabs mb-3" id="inputTabs">
                    <li class="nav-item"><button class="nav-link active" type="button" data-bs-toggle="tab" data-bs-target="#textTab">✍️ Tekst plakken</button></li>
                    <li class="nav-item"><button class="nav-link" type="button" data-bs-toggle="tab" data-bs-target="#pdfTab">📄 PDF uploaden</button></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="textTab">
                        <textarea name="cvText" class="form-control" rows="12" placeholder="Plak hier je cv-tekst..."></textarea>
                    </div>
                    <div class="tab-pane" id="pdfTab">
                        <input type="file" name="pdfFile" class="form-control" accept=".pdf" />
                        <small class="text-muted">Maximaal 5MB</small>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3 w-100">
                    <i class="bi bi-magic"></i> Analyseer mijn CV
                </button>
            </form>
        </div>
    </div>
</div>
</div>
