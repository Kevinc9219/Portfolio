@model Order
@{ViewData["Title"] = "Nieuwe Bestelling";}
<h1>Nieuwe Bestelling</h1>
<form asp-action="Create" method="post" class="row g-3">
    <div class="col-md-6"><label asp-for="ProductId" class="form-label">Product</label>
        <select asp-for="ProductId" class="form-select">
            @foreach (var p in (IEnumerable<Product>)ViewBag.Products) { <option value="@p.Id">@p.Name (SKU: @p.SKU)</option> }
        </select>
    </div>
    <div class="col-md-3"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" /></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Bestelling plaatsen</button> <a asp-action="Index" class="btn btn-secondary">Annuleren</a></div>
</form>
