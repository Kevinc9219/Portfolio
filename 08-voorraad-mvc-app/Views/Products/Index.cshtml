@model IEnumerable<Product>
@{ViewData["Title"] = "Producten";}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Producten</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nieuw Product</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Zoek op naam of SKU..." /></div>
    <div class="col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">Alle categorieën</option>
            @foreach (var c in (IEnumerable<Category>)ViewBag.Categories) { <option value="@c.Id">@c.Name</option> }
        </select>
    </div>
    <div class="col-md-2"><button type="submit" class="btn btn-outline-secondary">Zoek</button></div>
</form>
<table class="table table-hover">
    <thead class="table-dark"><tr><th>Naam</th><th>SKU</th><th>Categorie</th><th>Leverancier</th><th>Prijs</th><th>Voorraad</th><th>Acties</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td><td>@p.SKU</td><td>@p.Category?.Name</td><td>@p.Supplier?.Name</td>
            <td>€@p.Price.ToString("F2")</td>
            <td class="@(p.StockQuantity < 10 ? "text-danger fw-bold" : "")">@p.StockQuantity</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Bewerk</a>
                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Verwijder</a>
            </td>
        </tr>
    }
    </tbody>
</table>
