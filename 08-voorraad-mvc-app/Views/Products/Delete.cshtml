@model Product
@{ViewData["Title"] = "Product Verwijderen";}
<h1>Product Verwijderen</h1>
<div class="alert alert-danger">Weet je zeker dat je <strong>@Model.Name</strong> (SKU: @Model.SKU) wilt verwijderen?</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Ja, verwijder</button>
    <a asp-action="Index" class="btn btn-secondary">Annuleren</a>
</form>
