<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voorraad</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/"><i class="bi bi-box-seam"></i> VoorraadBeheer</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="nav-link" asp-controller="Products" asp-action="Index">Producten</a>
            <a class="nav-link" asp-controller="Suppliers" asp-action="Index">Leveranciers</a>
            <a class="nav-link" asp-controller="Orders" asp-action="Index">Bestellingen</a>
        </div>
    </div>
</nav>
<main class="container mt-4">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
