@model IEnumerable<TaskItem>
@{ViewData["Title"] = "Dashboard";}
<div class="d-flex justify-content-between mb-3">
    <h1><i class="bi bi-list-task"></i> Mijn Taken</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nieuwe Taak</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card text-center bg-light"><div class="card-body"><h6>Alle taken</h6><h2>@ViewBag.TotalTasks</h2></div></div></div>
    <div class="col-md-3"><div class="card text-center text-white bg-danger"><div class="card-body"><h6>Hoge prioriteit</h6><h2>@ViewBag.HighPriority</h2></div></div></div>
    <div class="col-md-3"><div class="card text-center text-white bg-success"><div class="card-body"><h6>Voltooid</h6><h2>@ViewBag.Completed</h2></div></div></div>
</div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Alle</a>
    <a asp-action="Index" asp-route-filter="high" class="btn btn-sm btn-danger">Hoog</a>
    <a asp-action="Index" asp-route-filter="open" class="btn btn-sm btn-primary">Open</a>
    <a asp-action="Index" asp-route-filter="done" class="btn btn-sm btn-success">Voltooid</a>
    @if (ViewBag.Categories != null)
    { foreach (var c in (IEnumerable<string>)ViewBag.Categories) { <a asp-action="Index" asp-route-category="@c" class="btn btn-sm btn-outline-secondary">@c</a> } }
</div>

<div class="row g-2">
@foreach (var task in Model)
{
    var priorityColor = task.EffectivePriority == Priority.Hoog ? "danger" : task.EffectivePriority == Priority.Midden ? "warning" : "success";
    <div class="col-12">
        <div class="card @(task.IsCompleted ? "opacity-50" : "") border-@priorityColor border-start border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="@(task.IsCompleted ? "text-decoration-line-through" : "")">@task.Title</h6>
                    <small>
                        <span class="badge bg-@priorityColor">@task.EffectivePriority</span>
                        <span class="badge bg-secondary">@task.EffectiveCategory</span>
                        @if (task.AiDurationMinutes > 0) { <span class="text-muted">⏱ @task.AiDurationMinutes min</span> }
                        @if (task.Deadline.HasValue) { <span class="text-info ms-1">📅 @task.Deadline.Value.ToString("dd/MM")</span> }
                        @if (!string.IsNullOrEmpty(task.AiReasoning)) { <small class="text-muted ms-2 fst-italic">@task.AiReasoning</small> }
                    </small>
                </div>
                <div class="btn-group">
                    <form asp-action="Complete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@task.Id" />
                        <button type="submit" class="btn btn-sm @(task.IsCompleted ? "btn-outline-secondary" : "btn-success")">
                            @(task.IsCompleted ? "↩" : "✓")
                        </button>
                    </form>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@task.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Verwijderen?')">×</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
</div>
